---
import { Icon } from "astro-icon/components";
import ConfirmModal from "../global/ConfirmModal.astro";

interface Props {
  recipeId: number;
}

const { recipeId } = Astro.props;
---

<button
  id="delete-recipe-btn"
  class="delete-btn"
  data-recipe-id={recipeId}
  onclick="document.getElementById('delete-recipe').showModal()"
>
  <Icon name="lucide:trash-2" class="delete-icon" />
  <span>Delete Recipe</span>
</button>

<ConfirmModal
  modalId="delete-recipe"
  title="Delete Recipe"
  message="This action cannot be undone. Are you sure you want to proceed?"
  actionUrl=`/api/recipe/${recipeId}/delete`
  redirectUrl="/dishBox"
  method="DELETE"
/>

<style>
  .delete-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--error);
    background-color: var(--error-bg);
    border: 1.5px solid rgba(225, 29, 72, 0.25);
    border-radius: 0.65rem;
    cursor: pointer;
    font-family: inherit;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .delete-btn:hover {
    background-color: rgba(225, 29, 72, 0.12);
    border-color: rgba(225, 29, 72, 0.45);
    transform: translateY(-1px);
  }

  .delete-btn:active {
    transform: translateY(0);
  }

  .delete-icon {
    width: 1rem;
    height: 1rem;
  }
</style>
