---
import Layout from "@/components/layouts/Layout.astro";
import Header from "../global/Header.astro";

interface Props {
  title?: string;
}

const { title = "FoodBox" } = Astro.props;
---

<Layout title={title}>
  <Header />
  <main>
    <slot />
  </main>
  <footer></footer>
</Layout>

<style>
  main {
    background-color: var(--bg-app);
    padding: 2rem 2.5rem;
    min-height: calc(100vh - 4.5rem);
    box-sizing: border-box;
  }
</style>
