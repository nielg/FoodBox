---
import type { RecipeMetaDataResponse } from "@/types/recipe/recipe.schemas";
import RecipesCard from "../recipesMetaData/RecipesMetaDataCard";
type Props = {
  title?: string;
  recipes: RecipeMetaDataResponse[];
};

const { user_id } = Astro.locals;

const { title, recipes } = Astro.props as Props;
---

<section class="recipes-carrousel">
  {title && <h2>{title}</h2>}

  <div class="recipes-carrousel__wrapper">
    <button class="carousel-arrow left" aria-label="Scroll left" data-dir="-1">
      &#10094;
    </button>

    <div class="recipes-carrousel__container">
      {
        recipes.map((recipe) => (
          <div class="recipes-carrousel__item">
            <RecipesCard data={recipe} userId={user_id} client:visible />
          </div>
        ))
      }
    </div>

    <button class="carousel-arrow right" aria-label="Scroll right" data-dir="1">
      &#10095;
    </button>
  </div>
</section>
<script>
  function setupCarousels() {
    const wrappers = document.querySelectorAll(".recipes-carrousel__wrapper");

    wrappers.forEach((wrapper) => {
      const container = wrapper.querySelector(
        ".recipes-carrousel__container",
      ) as HTMLElement;
      const arrows = wrapper.querySelectorAll(".carousel-arrow");

      if (!container) return;

      arrows.forEach((arrow) => {
        arrow.addEventListener("click", () => {
          const direction = Number((arrow as HTMLElement).dataset.dir);
          // Scroll by ~75% of the visible container width
          const scrollAmount = container.clientWidth * 0.75 * direction;

          container.scrollBy({
            left: scrollAmount,
            behavior: "smooth",
          });
        });
      });
    });
  }

  // Run on initial load
  setupCarousels();
</script>
<style>
  .recipes-carrousel {
    margin: 2rem 0;
    padding: 0 1rem;
  }

  .recipes-carrousel h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .recipes-carrousel__wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .recipes-carrousel__container {
    display: flex;
    overflow-x: hidden;
    scroll-behavior: smooth;
    gap: 1rem;
    padding: 0.5rem 0;
    width: 100%;
  }

  .recipes-carrousel__item {
    flex: 0 0 auto;
    width: calc(25% - 1rem);
    min-width: 16rem;
  }

  .carousel-arrow {
    background-color: var(--bg-surface);
    border: none;
    cursor: pointer;
    font-size: 2rem;
    padding: 0.5rem;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease,
      opacity 0.3s ease;
    opacity: 0.7;
  }

  .carousel-arrow:hover {
    background-color: var(--primary-100);
    color: var(--primary-700);
    transform: translateY(-50%) scale(1.1);
    box-shadow: var(--shadow-md);
    opacity: 1;
  }

  .carousel-arrow.left {
    left: -2rem;
  }

  .carousel-arrow.right {
    right: -2rem;
  }
</style>
