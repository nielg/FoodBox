---
import ConfirmModal from "@/components/global/ConfirmModal.astro";
---

<section class="danger-zone" aria-labelledby="danger-zone-heading">
  <div class="danger-copy">
    <span class="danger-eyebrow">Danger zone</span>
    <h2 id="danger-zone-heading">Delete your account</h2>
    <p>
      Permanently remove your account and its associated data. This action
      cannot be undone.
    </p>
  </div>
  <button
    type="button"
    class="delete-button"
    onclick="document.getElementById('delete-account').showModal()"
  >
    Delete account
  </button>

  <ConfirmModal
    modalId="delete-account"
    title="Delete Account"
    message="This action cannot be undone. Are you sure you want to proceed?"
    actionUrl="/api/user/delete"
    method="DELETE"
  />
</section>

<style>
  .danger-zone {
    display: flex;
    box-sizing: border-box;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid #fecdd3;
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .danger-copy {
    max-width: 38rem;
  }

  .danger-eyebrow {
    color: var(--error-hover);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .danger-copy h2 {
    margin: 0.3rem 0 0;
    color: var(--text-primary);
    font-size: 1.05rem;
  }

  .danger-copy p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .delete-button {
    flex: 0 0 auto;
    padding: 0.65rem 0.9rem;
    color: var(--error-hover);
    background-color: var(--bg-surface);
    border: 1px solid #fda4af;
    border-radius: 0.65rem;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .delete-button:hover {
    color: white;
    background-color: var(--error-hover);
    border-color: var(--error-hover);
  }

  .delete-button:focus-visible {
    outline: 3px solid #fda4af;
    outline-offset: 3px;
  }

  @media (max-width: 520px) {
    .danger-zone {
      align-items: flex-start;
      flex-direction: column;
      padding: 1.2rem;
    }
  }
</style>
