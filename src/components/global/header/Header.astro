---
import UserProfileDropDown from "./UserProfileDropDown.astro";
import Navigation from "./Navigation.tsx";
---

<header class="text-white">
  <a href="/">
    <h2>FoodBox</h2>
  </a>
  <div class="right-header">
    <Navigation client:load />
    <UserProfileDropDown />
  </div>
</header>

<style>
  header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    font-size: 1.5rem;
    padding: 0 2rem;
    background-color: rgba(18, 178, 178, 0.761);
  }

  h2,
  .icon {
    font-size: 1.8rem;
  }

  .right-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    justify-content: center;
    gap: 3rem;
  }
</style>
