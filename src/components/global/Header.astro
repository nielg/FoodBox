---
import UserProfileDropDown from "@/components/user/UserProfileDropDown.astro";
---

<header class="text-white">
  <a href="/">
    <h2>FoodBox</h2>
  </a>
  <div class="right-header">
    <a href="/dishBox">dishBox</a>
    <a href="/stockBox">stockBox</a>
    <UserProfileDropDown />
  </div>
</header>

<style>
  header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 2rem;
    font-size: 1.5rem;
    border-top: none;
    background-color: rgba(18, 178, 178, 0.761);
  }

  h2,
  .icon {
    font-size: 1.8rem;
  }

  .right-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }
</style>
