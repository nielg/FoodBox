---
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import WelcomeHeader from "@/components/global/WelcomeHeader.astro";
import DeleteUser from "@/components/user/profile/DeleteUser.astro";
import UpdateUser from "@/components/user/profile/UpdateUser.tsx";
import UserService from "@/service/userService";

const { user_id } = Astro.locals;

if (!user_id) {
  return Astro.redirect("/user/login");
}

const profile = await UserService.getUserData(user_id);
const initials =
  `${profile.firstname.charAt(0)}${profile.lastname.charAt(0)}`.toUpperCase();
---

<BaseLayout title="Profile | DishBox">
  <div class="profile-page">
    <WelcomeHeader
      title="Your profile"
      subtitle="Manage your account details and preferences."
    />

    <div class="profile-grid">
      <UpdateUser client:load initData={profile} />

      <aside class="profile-aside">
        <section class="account-card" aria-labelledby="account-heading">
          <div class="account-avatar" aria-hidden="true">{initials}</div>
          <span class="account-eyebrow">Your account</span>
          <h2 id="account-heading">{profile.username}</h2>
          <p>{profile.email}</p>
          <div class="account-divider"></div>
          <p class="account-hint">
            Keep your details up to date so your DishBox account stays easy to
            recognize.
          </p>
        </section>
      </aside>
    </div>

    <DeleteUser />
  </div>
</BaseLayout>

<style>
  .profile-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: min(100%, 68rem);
    margin: 0 auto;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.65fr);
    align-items: start;
    gap: 1.25rem;
  }

  .profile-aside {
    min-width: 0;
  }

  .account-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
    background:
      radial-gradient(ellipse at top right, var(--primary-50), transparent 65%),
      var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    box-shadow: var(--shadow-md);
  }

  .account-avatar {
    display: grid;
    width: 4rem;
    height: 4rem;
    margin-bottom: 1.25rem;
    place-items: center;
    color: var(--text-inverse);
    background: var(--gradient-ocean);
    border: 3px solid var(--bg-surface);
    border-radius: 50%;
    box-shadow: var(--shadow-ocean);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .account-eyebrow {
    color: var(--primary-700);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-card h2 {
    margin: 0.35rem 0 0;
    color: var(--text-primary);
    font-size: 1.35rem;
    overflow-wrap: anywhere;
  }

  .account-card p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .account-divider {
    width: 100%;
    height: 1px;
    margin: 1.25rem 0 0.75rem;
    background: var(--border-subtle);
  }

  .account-card .account-hint {
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .profile-aside {
      grid-row: 1;
    }
  }

  @media (max-width: 520px) {
    .profile-page {
      gap: 1.25rem;
    }

    .account-card {
      padding: 1.25rem;
    }
  }
</style>
