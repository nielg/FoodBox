---
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import GoBackBtn from "@/components/buttons/GoBackBtn.astro";
import type { RecipeResponse } from "@/types/recipe/recipe.schemas";
import EditRecipeBtn from "@/components/buttons/EditRecipeBtn.astro";
import Recipe from "@/components/dishBox/recipe/Recipe";
import RecipeService from "@/service/dishBox/recipeService";

const { slug } = Astro.params;
const { user_id } = Astro.locals;

let recipe: RecipeResponse | undefined;

if (slug) {
  const id = parseInt(slug, 10);

  if (!isNaN(id)) {
    try {
      recipe = await RecipeService.getRecipeById(id);
    } catch (error) {
      console.error(`Failed to fetch recipe with ID ${id}:`, error);
    }
  }
}

const isForbidden = !recipe?.public && recipe?.user_id !== user_id;
console.log(isForbidden, recipe);

if (!recipe || isForbidden) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}
---

<BaseLayout
  title={recipe ? `${recipe.title} | DishBox` : "Recipe Not Found | DishBox"}
>
  <div class="recipe-nav">
    <GoBackBtn href="/dishBox" />

    {recipe?.user_id === user_id && <EditRecipeBtn recipeId={recipe.id} />}
  </div>
  <Recipe recipe={recipe} client:load />
</BaseLayout>

<style>
  /* ── Page shell ─────────────────────────────────────────────── */
  .recipe-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Nav row ────────────────────────────────────────────────── */
  .recipe-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Hero header ────────────────────────────────────────────── */
  .recipe-hero {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .recipe-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--primary-50);
    color: var(--primary-700);
    border: 1px solid var(--primary-200);
    padding: 0.3rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    width: fit-content;
  }

  .hero-badge-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .recipe-title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .recipe-description {
    margin: 0;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 680px;
  }

  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  /* ── Divider ────────────────────────────────────────────────── */
  .section-divider {
    width: 100%;
    height: 1px;
    background: var(--border-subtle);
  }

  /* ── Two-column body ────────────────────────────────────────── */
  .recipe-body {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 680px) {
    .recipe-body {
      grid-template-columns: 1fr;
    }
  }

  /* ── Shared section styles ──────────────────────────────────── */
  .recipe-section {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .section-icon-wrap {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: var(--gradient-seafoam);
    border: 1px solid var(--primary-200);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-icon {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--primary-700);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* ── Ingredients list ───────────────────────────────────────── */
  .ingredients-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ingredient-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    transition: background-color 0.15s ease;
  }

  .ingredient-item:hover {
    background-color: var(--bg-surface-subtle);
  }

  .ingredient-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--primary-400);
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  /* ── Instructions list ──────────────────────────────────────── */
  .instructions-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .instruction-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-number {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gradient-ocean);
    color: var(--text-inverse);
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-ocean);
  }

  .step-text {
    margin: 0;
    padding-top: 0.35rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* ── 404 state ──────────────────────────────────────────────── */
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 5rem 2rem;
    text-align: center;
  }

  .not-found-icon-wrap {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--gradient-seafoam);
    border: 1px solid var(--primary-200);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-icon {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--primary-600);
  }

  .not-found h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .not-found p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>

<script>
  window.addEventListener("message", (event) => {
    if (event.origin !== "http://localhost:4321") {
      return;
    }

    if (event.data?.type !== "RECIPE_DATA") {
      return;
    }

    const recipe = event.data.recipe;

    // Do something with recipe here
  });
</script>
