---
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import EditRecipeForm from "@/components/dishBox/recipe/edit/EditRecipeForm";
import WelcomeHeader from "@/components/global/WelcomeHeader.astro";
import GoBackBtn from "@/components/buttons/GoBackBtn.astro";
import TagRepository from "@/repository/dishBox/recipes/tagRepository";
const tags = await TagRepository.getAllTags();
---

<BaseLayout title="Add Recipe | DishBox">
  <div class="page-wrapper">
    <div class="page-nav">
      <GoBackBtn href="/dishBox" />
    </div>
    <WelcomeHeader
      title="Add a new Recipe"
      subtitle="Fill in the steps below to add your recipe to DishBox"
    />
    <EditRecipeForm tags={tags} client:load />
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-nav {
    display: flex;
    align-items: center;
  }
</style>
